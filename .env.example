# Copy to .env and fill in. Written with `export` so the file can be sourced directly:
#   source .env
# The dev extra installs python-dotenv, which the test suite uses to load this
# automatically without sourcing it.

# --- Connection ---
export CALDAV_CAL_API_URL="https://your-nextcloud.example.com"
export CALDAV_CAL_API_USERNAME="your-username"
export CALDAV_CAL_API_PASSWORD="your-app-password"

# --- Defaults ---
# Calendar acted on when neither the call nor the event names one.
export CALDAV_CAL_API_DEFAULT_CALENDAR_UID=""

# Load window, in days relative to now. Negative reaches into the past.
# The in-memory cache holds this window, NOT the whole calendar.
export CALDAV_CAL_API_WINDOW_START_DAYS="-30"
export CALDAV_CAL_API_WINDOW_END_DAYS="365"

# Set to 1/true/yes/on to ignore the window and load every event.
# Can be very slow on a long-lived calendar.
export CALDAV_CAL_API_FETCH_ALL="0"

# Console log level: DEBUG, INFO, WARNING, ERROR. The log file is always DEBUG.
export CALDAV_CAL_API_LOG_LEVEL="INFO"

# --- Test suite only ---
# The server-backed tests are skipped unless all four are set.
# CALDAV_CAL_API_TEST_CALENDAR_NAME must name a scratch calendar: the tests
# create and delete events in it.
export CALDAV_CAL_API_TEST_URL=""
export CALDAV_CAL_API_TEST_USERNAME=""
export CALDAV_CAL_API_TEST_PASSWORD=""
export CALDAV_CAL_API_TEST_CALENDAR_NAME=""
